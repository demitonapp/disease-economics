{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/demitonapp/disease-economics/schema/source.schema.json",
  "x-schema-version": "1.0.0",
  "title": "Source",
  "description": "The YAML frontmatter of sources/<slug>.md: where a figure came from, and how we read it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "organisation",
    "year",
    "source_type",
    "method",
    "access",
    "read_on",
    "location",
    "jurisdictions",
    "industries"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "organisation": {
      "type": "string",
      "minLength": 1
    },
    "organisation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "published_in": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "free_copy_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "source_type": {
      "enum": [
        "peer-reviewed",
        "working-paper",
        "regulator",
        "court",
        "industry-body",
        "research-institute",
        "vendor",
        "press"
      ]
    },
    "method": {
      "enum": [
        "survey",
        "records",
        "official-statistics",
        "model",
        "case-study",
        "legal-text",
        "estimate",
        "unknown"
      ]
    },
    "access": {
      "enum": [
        "primary",
        "secondary"
      ]
    },
    "read_via": {
      "type": "string",
      "minLength": 1
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "industries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "industry_as_published": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "access": {
            "const": "primary"
          }
        }
      },
      "then": {
        "required": [
          "url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "const": "secondary"
          }
        }
      },
      "then": {
        "required": [
          "read_via"
        ]
      }
    }
  ]
}
