{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/demitonapp/disease-economics/schema/finding.schema.json",
  "title": "Finding",
  "description": "One figure taken from one or more sources. diseases/<disease_key>/<metric_key>.yaml or context/<metric_key>.yaml. The path is the id; it is never repeated inside the file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "exposure_value",
    "exposure_unit",
    "exposure_basis",
    "exposure_kind",
    "confidence",
    "derivation",
    "sources",
    "sample_note",
    "caveat",
    "status"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "exposure_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "exposure_unit": {
      "enum": [
        "ratio_of_contract",
        "ratio_of_other",
        "per_wet_day",
        "per_incident",
        "none"
      ]
    },
    "denominator": {
      "enum": [
        "budget_at_decision",
        "budget_at_announcement",
        "construction_cost",
        "amount_claimed",
        "arbitration_cost",
        "total_injury_cost",
        "overrun_additional_cost",
        "annual_capital_budget"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "price_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "exposure_basis": {
      "type": "string",
      "minLength": 1
    },
    "exposure_kind": {
      "enum": [
        "contractor_loss",
        "money_at_stake",
        "owner_side",
        "societal",
        "context"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "low"
      ]
    },
    "is_headline": {
      "type": "boolean"
    },
    "exposure_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "kind"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "confidence_interval",
            "reported_min_max",
            "scenario",
            "across_studies"
          ]
        }
      }
    },
    "derivation": {
      "enum": [
        "as_published",
        "calculated"
      ]
    },
    "calculation": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "considered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/slug"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sample_note": {
      "type": "string",
      "minLength": 1
    },
    "caveat": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "current",
        "disputed",
        "withdrawn"
      ]
    },
    "dispute_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "withdrawn_reason": {
      "type": "string",
      "minLength": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changed_on",
          "reason"
        ],
        "properties": {
          "exposure_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "exposure_unit": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          },
          "exposure_range": {
            "type": "object"
          },
          "exposure_kind": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "is_headline": {
            "type": "boolean"
          },
          "changed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "change_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exposure_unit": {
            "const": "ratio_of_other"
          }
        }
      },
      "then": {
        "required": [
          "denominator"
        ]
      },
      "else": {
        "not": {
          "required": [
            "denominator"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "exposure_unit": {
            "enum": [
              "per_wet_day",
              "per_incident"
            ]
          }
        }
      },
      "then": {
        "required": [
          "currency",
          "price_year"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "currency"
              ]
            },
            {
              "required": [
                "price_year"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivation": {
            "const": "calculated"
          }
        }
      },
      "then": {
        "required": [
          "calculation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        }
      },
      "then": {
        "required": [
          "dispute_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "required": [
          "withdrawn_reason"
        ]
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "citation": {
      "description": "A source slug, or a slug plus the location in that source when it differs from the source file's own location.",
      "oneOf": [
        {
          "$ref": "#/$defs/slug"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "location"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/slug"
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
